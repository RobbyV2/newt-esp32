# Copy to .env in this directory; main/CMakeLists.txt turns each KEY into
# NEWT_KEY in <build>/esp-idf/main/newt_secrets.h at IDF configure time.

# Pangolin newt site credentials (from the Pangolin dashboard)
NEWT_ID=your_newt_id_here
NEWT_SECRET=your_newt_secret_here
NEWT_ENDPOINT=https://pangolin.example.com

# WiFi STA credentials used by the example app
WIFI_SSID=your_ssid
WIFI_PASS=your_wifi_password